# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings → API) — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (Project Settings → API) — server-only, never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter API key (openrouter.ai/keys) — server-only
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter model slug, pinned so it can change without a code change.
# Must support forced structured output (response_format: json_schema).
OPENROUTER_MODEL=your-chosen-model-slug

# Langfuse project keys (cloud.langfuse.com or self-hosted)
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Inngest (background job runtime, app.inngest.com). Set INNGEST_DEV=1 for local
# development against the local Inngest Dev Server — no keys needed in that mode.
# In production, INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY are required.
INNGEST_DEV=1
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# --- Production-only (Docker Compose / VPS deploy, see DEPLOYMENT.md) ---
# Public domain Traefik routes this app on. Find the real value from your
# Traefik container's TRAEFIK_HOST env var in Docker Manager (Hostinger's
# default template uses a sslip.io address, e.g. ai-tutor.187-127-173-25.sslip.io
# -- sslip.io resolves any "<label>.<ip-with-dashes>.sslip.io" to that IP with
# no DNS setup). Swap for a real domain later without a rebuild.
# APP_DOMAIN=ai-tutor.187-127-173-25.sslip.io
